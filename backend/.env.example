# Copy this file to .env and fill in values as needed.

# Only one of these is required for real AI analysis. If neither is set,
# the backend falls back to a keyword-based mock so the app still works.
OPENAI_API_KEY=
GEMINI_API_KEY=

# SQLite by default, no changes needed for the hackathon.
DATABASE_URL=sqlite:///./supportai.db

# Must match the Vite dev server URL for CORS to work.
FRONTEND_ORIGIN=http://localhost:5173
